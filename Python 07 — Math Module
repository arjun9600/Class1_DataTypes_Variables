        "    print(\"\\n--- Scientific Calculator ---\")\n",
        "    print(\"1. Square Root\")\n",
        "    print(\"2. Factorial\")\n",
        "    print(\"3. Natural Logarithm\")\n",
        "    print(\"4. Power (x^y)\")\n",
        "    print(\"5. Sine (degrees)\")\n",
        "    print(\"6. Cosine (degrees)\")\n",
        "    print(\"7. Tangent (degrees)\")\n",
        "    print(\"8. GCD\")\n",
        "    print(\"9. LCM\")\n",
        "    print(\"0. Exit\")\n",
        "\n",
        "    while True:\n",
        "        choice = input(\"Enter choice (0-9): \")\n",
        "\n",
        "        if choice == '0':\n",
        "            print(\"Exiting scientific calculator. Goodbye!\")\n",
        "            break\n",
        "\n",
        "        try:\n",
        "            if choice == '1':\n",
        "                num = float(input(\"Enter number: \"))\n",
        "                print(f\"Square Root of {num}: {math.sqrt(num):.4f}\")\n",
        "            elif choice == '2':\n",
        "                num = int(input(\"Enter non-negative integer: \"))\n",
        "                print(f\"Factorial of {num}: {math.factorial(num)}\")\n",
        "            elif choice == '3':\n",
        "                num = float(input(\"Enter number: \"))\n",
        "                print(f\"Natural Log of {num}: {math.log(num):.4f}\")\n",
        "            elif choice == '4':\n",
        "                base = float(input(\"Enter base: \"))\n",
        "                exp = float(input(\"Enter exponent: \"))\n",
        "                print(f\"{base}^{exp}: {math.pow(base, exp):.4f}\")\n",
        "            elif choice == '5':\n",
        "                angle_deg = float(input(\"Enter angle in degrees: \"))\n",
        "                print(f\"Sine of {angle_deg} degrees: {math.sin(math.radians(angle_deg)):.4f}\")\n",
        "            elif choice == '6':\n",
        "                angle_deg = float(input(\"Enter angle in degrees: \"))\n",
        "                print(f\"Cosine of {angle_deg} degrees: {math.cos(math.radians(angle_deg)):.4f}\")\n",
        "            elif choice == '7':\n",
        "                angle_deg = float(input(\"Enter angle in degrees: \"))\n",
        "                print(f\"Tangent of {angle_deg} degrees: {math.tan(math.radians(angle_deg)):.4f}\")\n",
