      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "--- Menu Driven Calculator ---\n",
            "1. Arithmetic operations\n",
            "2. Compare two numbers\n",
            "3. Bitwise operations\n",
            "4. Membership check (number in a list)\n",
            "5. Identity check (is vs ==)\n",
            "6. Exit\n",
            "Choose an option (1-6): 1\n",
            "Enter first number: 20\n",
            "Enter second number: 6\n",
            "Sum: 26.0, Diff: 14.0, Product: 120.0\n",
            "Division: 3.3333333333333335, Modulus: 2.0\n",
            "\n",
            "--- Menu Driven Calculator ---\n",
            "1. Arithmetic operations\n",
            "2. Compare two numbers\n",
            "3. Bitwise operations\n",
            "4. Membership check (number in a list)\n",
            "5. Identity check (is vs ==)\n",
            "6. Exit\n",
            "Choose an option (1-6): 4\n",
            "Enter a number to search in [10, 20, 30, 40, 50]: 30\n",
            "30 is present in the list\n",
            "\n",
            "--- Menu Driven Calculator ---\n",
            "1. Arithmetic operations\n",
            "2. Compare two numbers\n",
            "3. Bitwise operations\n",
            "4. Membership check (number in a list)\n",
            "5. Identity check (is vs ==)\n",
            "6. Exit\n",
            "Choose an option (1-6): 6\n",
            "Exiting calculator. Bye!\n"
          ]
        }
      ],
      "source": [
        "def menu_driven_calculator():\n",
        "    while True:\n",
        "        print(\"\\n--- Menu Driven Calculator ---\")\n",
        "        print(\"1. Arithmetic operations\")\n",
        "        print(\"2. Compare two numbers\")\n",
        "        print(\"3. Bitwise operations\")\n",
        "        print(\"4. Membership check (number in a list)\")\n",
        "        print(\"5. Identity check (is vs ==)\")\n",
        "        print(\"6. Exit\")\n",
        "\n",
        "        choice = input(\"Choose an option (1-6): \")\n",
        "\n",
        "        if choice == \"1\":\n",
        "            x = float(input(\"Enter first number: \"))\n",
        "            y = float(input(\"Enter second number: \"))\n",
        "            print(f\"Sum: {x + y}, Diff: {x - y}, Product: {x * y}\")\n",
        "            if y != 0:\n",
        "                print(f\"Division: {x / y}, Modulus: {x % y}\")\n",
        "            else:\n",
        "                print(\"Division/modulus skipped (divide by zero)\")\n",
        "\n",
        "        elif choice == \"2\":\n",
        "            x = float(input(\"Enter first number: \"))\n",
        "            y = float(input(\"Enter second number: \"))\n",
